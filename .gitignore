# --- Dependencies (never upload to Hostinger) ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Environment & secrets (set in Hostinger hPanel instead) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- Build outputs (generated before deploy via npm run deploy:prepare) ---
frontend/dist/
backend/public/

# --- Hostinger deploy artifacts ---
*.zip
hostinger-deploy/
deploy.zip

# --- Logs & runtime ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Vite / tooling cache ---
frontend/.vite/
.vite/
.cache/

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE ---
.idea/
*.swp
*.swo
*~
